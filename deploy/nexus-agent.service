[Unit]
Description=Nexus privileged local agent
After=local-fs.target network.target smbd.service

[Service]
Type=simple
User=root
Group=nexus
ExecStart=/opt/nexus/runtime/bin/node /opt/nexus/current/agent/main.js
Restart=on-failure
RestartSec=2
RuntimeDirectory=nexus-agent
RuntimeDirectoryMode=0750
StateDirectory=nexus-agent
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
# Mount operations must be visible in the host namespace. Do not use
# PrivateMounts, ProtectHome, ProtectSystem, ProtectKernel* or ReadWritePaths.

[Install]
WantedBy=multi-user.target
